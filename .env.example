# Postgres + pgvector (Neon). Fake URL — thay bằng connection string Neon thật.
DATABASE_URL=postgresql://user:password@ep-fake-project.us-east-2.aws.neon.tech/vinuni_rag?sslmode=require

# Trống thì dùng chung OPENAI_API/OPENAI_BASE_URL (OpenRouter) — chỉ điền nếu
# embedding tách nhà cung cấp/key riêng.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSION=1536

EMBEDDING_BATCH_SIZE=8
CHUNKS_FILE=src/rag/chunks.json
PG_TABLE=ai_thuc_chien_chunks

# Số chunk lấy mỗi lần truy xuất — nguồn sự thật duy nhất cho top_k
# (Settings.from_env, pg_retrieval CLI).
TOP_K=3

# Ngưỡng cosine similarity: dưới mức này coi là không đủ căn cứ để trả lời trực tiếp.
# Nguồn sự thật duy nhất ở src/rag/settings.py (RagSettings) — rag_bridge.py và
# tools/contact_support.py cùng đọc từ đây, không tự hardcode nữa.
GROUNDING_THRESHOLD=0.7

# DEBUG log toàn bộ chunk truy xuất, prompt gửi LLM, và từng node LangGraph.
LOG_LEVEL=INFO

# API này chỉ dùng cho model chat, không dùng cho embedding.
OPENAI_API=
OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=1024
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# Judge model — model rẻ/nhỏ riêng cho planner (chọn query_split/hyde/... theo câu hỏi) và
# các bước phân loại phụ khác. Trống thì dùng chung OPENAI_API/OPENAI_MODEL/OPENAI_BASE_URL.
JUDGE_API=
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_TIMEOUT_SECONDS=60
JUDGE_MAX_RETRIES=2
